---
import { thumbnail } from '@/data/videos';
import Icon from './Icon.astro';

interface Props {
  youtubeId: string;
  title: string;
  /** Render larger play button / 16:9 hero variant. */
  class?: string;
  /**
   * When set, the facade becomes a LINK to this URL (e.g. the video's page)
   * instead of loading the iframe inline — used on the homepage hero so the
   * featured thumbnail drives to /video/<slug> with the full transcript.
   */
  href?: string;
}
const { youtubeId, title, class: className = '', href } = Astro.props;
const poster = thumbnail(youtubeId, 'max');
const posterFallback = thumbnail(youtubeId, 'hq');

const facadeClass = ['group relative block aspect-video w-full overflow-hidden rounded-xl bg-black', className];
---
{href ? (
  <!-- Linked facade: navigates to the video's page (with transcript) instead of playing inline. -->
  <a href={href} class:list={facadeClass} aria-label={`Watch: ${title}`}>
    <img
      src={poster}
      data-fallback={posterFallback}
      alt={`Thumbnail: ${title}`}
      loading="lazy"
      decoding="async"
      width="1280"
      height="720"
      onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback}"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute inset-0 flex items-center justify-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600/90 text-white shadow-lg transition-transform duration-200 group-hover:scale-110">
        <Icon name="play" class="h-8 w-8 translate-x-0.5" />
      </span>
    </span>
  </a>
) : (
  <!-- Lightweight click-to-load YouTube facade: avoids loading the heavy iframe until play. -->
  <lite-yt class:list={facadeClass} data-id={youtubeId} data-title={title}>
    <img
      src={poster}
      data-fallback={posterFallback}
      alt={`Thumbnail: ${title}`}
      loading="lazy"
      decoding="async"
      width="1280"
      height="720"
      onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback}"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <button type="button" class="absolute inset-0 flex items-center justify-center" aria-label={`Play: ${title}`}>
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600/90 text-white shadow-lg transition-transform duration-200 group-hover:scale-110">
        <Icon name="play" class="h-8 w-8 translate-x-0.5" />
      </span>
    </button>
  </lite-yt>
)}

<script>
  class LiteYT extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => this.activate());
    }
    activate() {
      const id = this.dataset.id;
      const title = this.dataset.title ?? '';
      const iframe = document.createElement('iframe');
      iframe.width = '560';
      iframe.height = '315';
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      this.replaceChildren(iframe);
    }
  }
  if (!customElements.get('lite-yt')) customElements.define('lite-yt', LiteYT);
</script>
