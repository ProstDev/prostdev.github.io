---
import Icon from './Icon.astro';

interface Props {
  /** Path to the raw markdown endpoint, e.g. /post/foo.md or /video/bar.md */
  markdownUrl: string;
}
const { markdownUrl } = Astro.props;
---
<!-- MuleSoft-docs-style split button: primary = Copy as Markdown, caret opens menu. -->
<div class="doc-actions relative inline-flex" data-md-url={markdownUrl}>
  <button
    type="button"
    data-action="copy"
    class="inline-flex items-center gap-2 rounded-l-lg border border-default bg-surface-card px-3 py-1.5 text-sm font-semibold text-accent transition-colors hover:bg-[color:var(--bg-subtle)]"
  >
    <span data-copy-idle><Icon name="copy" class="h-4 w-4" /></span>
    <span data-copy-done class="hidden text-green-500"><Icon name="check" class="h-4 w-4" /></span>
    <span data-copy-label>Copy as Markdown</span>
  </button>
  <button
    type="button"
    data-action="toggle"
    class="inline-flex items-center justify-center rounded-r-lg border border-l-0 border-default bg-surface-card px-2 py-1.5 text-accent transition-colors hover:bg-[color:var(--bg-subtle)]"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="More markdown options"
  >
    <Icon name="chevron-down" class="h-4 w-4" />
  </button>

  <div
    data-menu
    class="absolute right-0 top-full z-30 mt-1 hidden w-56 overflow-hidden rounded-lg border border-default bg-surface-card py-1 shadow-lg"
    role="menu"
  >
    {[
      { path: markdownUrl, label: 'Copy Markdown link' },
      { path: '/llms.txt', label: 'Copy llms.txt link' },
    ].map(({ path, label }) => (
      <button type="button" data-copy-link={path} role="menuitem" class="flex w-full items-center justify-between gap-2 px-4 py-2 text-left text-sm text-default hover:bg-[color:var(--bg-subtle)]">
        <span data-link-label>{label}</span>
        <span data-link-idle><Icon name="link" class="h-4 w-4 text-muted" /></span>
        <span data-link-done class="hidden text-green-500"><Icon name="check" class="h-4 w-4" /></span>
      </button>
    ))}
  </div>
  <span data-live class="sr-only" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.doc-actions').forEach((root) => {
    const url = root.dataset.mdUrl!;
    const menu = root.querySelector<HTMLElement>('[data-menu]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-action="toggle"]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-action="copy"]')!;
    const idle = root.querySelector<HTMLElement>('[data-copy-idle]')!;
    const done = root.querySelector<HTMLElement>('[data-copy-done]')!;
    const label = root.querySelector<HTMLElement>('[data-copy-label]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;

    const closeMenu = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    copyBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(url);
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        idle.classList.add('hidden');
        done.classList.remove('hidden');
        label.textContent = 'Copied!';
        live.textContent = 'Copied';
        setTimeout(() => {
          idle.classList.remove('hidden');
          done.classList.add('hidden');
          label.textContent = 'Copy as Markdown';
        }, 2000);
      } catch {
        // Fallback: open the raw markdown in a new tab.
        window.open(url, '_blank');
      }
    });

    // Menu items copy an ABSOLUTE URL (paste-ready for an agent like Claude Code),
    // not the page content — swap the item's icon/label to "Copied!" briefly, then close.
    root.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((item) => {
      const itemLabel = item.querySelector<HTMLElement>('[data-link-label]')!;
      const itemIdle = item.querySelector<HTMLElement>('[data-link-idle]')!;
      const itemDone = item.querySelector<HTMLElement>('[data-link-done]')!;
      const original = itemLabel.textContent ?? '';
      item.addEventListener('click', async (e) => {
        e.stopPropagation();
        const link = new URL(item.dataset.copyLink!, window.location.origin).href;
        try {
          await navigator.clipboard.writeText(link);
        } catch {
          // Fallback: clipboard blocked — open the link so it can be copied from the address bar.
          window.open(link, '_blank');
          return;
        }
        itemIdle.classList.add('hidden');
        itemDone.classList.remove('hidden');
        itemLabel.textContent = 'Copied!';
        live.textContent = 'Link copied';
        setTimeout(() => {
          itemIdle.classList.remove('hidden');
          itemDone.classList.add('hidden');
          itemLabel.textContent = original;
          live.textContent = '';
          closeMenu();
        }, 1200);
      });
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  });
</script>
