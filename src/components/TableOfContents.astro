---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// Show h2 + h3 only — h1 is the page title.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{toc.length > 0 && (
  <nav class="toc text-sm" aria-label="On this page">
    <p class="mb-3 font-semibold text-default">On this page</p>
    <ul class="space-y-2 border-l border-default max-h-[calc(100vh-10rem)] overflow-y-auto overscroll-contain pr-2">
      {toc.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={[
              'block border-l-2 border-transparent -ml-px py-0.5 text-muted transition-colors hover:text-accent',
              h.depth === 2 ? 'pl-4' : 'pl-7',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc a[data-active='true'] {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  // Scroll-spy: highlight the TOC link for the heading currently in view.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
  );
  if (links.length) {
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink, l]));
    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => !!el);

    // The scrollable ToC list (its own overflow box) — used to keep the active
    // link in view without ever scrolling the page.
    const scroller = links[0].closest<HTMLElement>('ul');
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    let activeSlug: string | null = null;
    const setActive = (slug: string | null) => {
      if (slug === activeSlug) return;
      if (activeSlug) bySlug.get(activeSlug)?.removeAttribute('data-active');
      if (slug) {
        const link = bySlug.get(slug);
        link?.setAttribute('data-active', 'true');
        // Auto-scroll the active link into view INSIDE the ToC list only when
        // the list actually overflows. `block: 'nearest'` scrolls the nearest
        // scrollable ancestor (the <ul>) the minimum amount and never moves the
        // page; skip it if the list isn't scrollable so nothing janks.
        if (link && scroller && scroller.scrollHeight > scroller.clientHeight) {
          link.scrollIntoView({
            block: 'nearest',
            behavior: reduceMotion ? 'auto' : 'smooth',
          });
        }
      }
      activeSlug = slug;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
