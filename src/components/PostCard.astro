---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { postUrl, formatDate } from '@/lib/content';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TagChip from '@/components/TagChip.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, category, tags, heroImage, youtubeId } = post.data;
const url = postUrl(post.id);
---
<article class="group relative isolate flex h-full flex-col overflow-hidden rounded-xl border border-[var(--border)] bg-surface-card transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-lg">
  <div class="relative overflow-hidden">
    {heroImage ? (
      <Image src={heroImage} alt={title} width={640} height={360} class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105" />
    ) : (
      <div class="aspect-video w-full bg-gradient-to-br from-brand-400 to-brand-700"></div>
    )}
    {youtubeId && (
      <span class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-black/70 px-2 py-1 text-xs font-semibold text-white backdrop-blur-sm">
        <Icon name="play" class="h-3 w-3" />
        Video
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="relative z-10 mb-2 w-fit">
      <CategoryBadge category={category} />
    </div>
    <h3 class="text-lg font-bold leading-snug">
      <a href={url} class="text-default transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent">{title}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm text-muted">{description}</p>
    <div class="mt-auto">
      {tags.length > 0 && (
        <div class="relative z-10 mt-4 flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((t) => <TagChip tag={t} />)}
        </div>
      )}
      <p class="mt-3 text-xs text-muted">{formatDate(pubDate)}</p>
    </div>
  </div>
</article>
