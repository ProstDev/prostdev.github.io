---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { postUrl, formatDate } from '@/lib/content';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TagChip from '@/components/TagChip.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, category, tags, heroImage } = post.data;
const url = postUrl(post.id);
---
<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-default bg-surface-card transition-shadow hover:shadow-md">
  <a href={url} class="block">
    {heroImage ? (
      <Image src={heroImage} alt={title} width={640} height={360} class="aspect-video w-full object-cover" />
    ) : (
      <div class="aspect-video w-full bg-gradient-to-br from-brand-400 to-brand-700"></div>
    )}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2">
      <CategoryBadge category={category} />
    </div>
    <h3 class="text-lg font-bold leading-snug">
      <a href={url} class="text-default transition-colors group-hover:text-accent">{title}</a>
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-muted">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((t) => <TagChip tag={t} />)}
      </div>
    )}
    <p class="mt-3 text-xs text-muted">{formatDate(pubDate)}</p>
  </div>
</article>
