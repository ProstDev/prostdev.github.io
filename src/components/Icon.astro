---
/**
 * Inline SVG icons (no external dependency). Pass `name` and optional `class`.
 */
interface Props {
  name:
    | 'youtube'
    | 'github'
    | 'linkedin'
    | 'sun'
    | 'moon'
    | 'search'
    | 'chevron-down'
    | 'chevron-right'
    | 'arrow-left'
    | 'arrow-right'
    | 'copy'
    | 'check'
    | 'external'
    | 'markdown'
    | 'mail'
    | 'menu'
    | 'close'
    | 'rocket'
    | 'play'
    | 'file-text'
    | 'sparkles'
    | 'info'
    | 'lightbulb'
    | 'alert-circle'
    | 'alert-triangle'
    | 'alert-octagon'
    | 'book';
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
const sw = 1.8;
