---
import { NAV, SOCIAL, SITE } from '@/config';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SearchTrigger from './SearchTrigger.astro';
import ThemeToggle from './ThemeToggle.astro';

const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Hello from prostdev.com')}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---
<header class="sticky top-0 z-50 border-b border-default bg-surface/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2 font-extrabold tracking-tight">
      <Logo class="h-9 w-9 text-accent" />
      <span class="text-lg">
        <span class="text-accent">Prost</span><span class="text-default">Dev</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="ml-2 hidden items-center gap-1 lg:flex" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-accent/12 text-accent'
              : 'text-muted hover:text-default hover:bg-[color:var(--bg-subtle)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <!-- Search: full input-style box on md+, icon-only on small screens -->
      <div class="hidden md:block"><SearchTrigger /></div>
      <div class="md:hidden"><SearchTrigger compact /></div>
      <!-- Social (desktop) -->
      <div class="hidden items-center gap-1 sm:flex">
        <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:text-[#ff0000]"><Icon name="youtube" /></a>
        <a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub" class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:text-default"><Icon name="github" /></a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:text-[#0a66c2]"><Icon name="linkedin" /></a>
        <a href={mailto} aria-label="Email Alex" title="Email me" class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:text-accent"><Icon name="mail" /></a>
      </div>
      <ThemeToggle />
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-default text-muted lg:hidden" aria-label="Open menu" aria-expanded="false">
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- Mobile nav drawer -->
  <nav id="mobile-menu" class="hidden border-t border-default bg-surface lg:hidden" aria-label="Mobile">
    <div class="space-y-1 px-4 py-3">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'block rounded-lg px-3 py-2 text-sm font-medium',
            isActive(item.href) ? 'bg-accent/12 text-accent' : 'text-muted hover:text-default',
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="flex gap-2 px-3 pt-2">
        <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="text-muted hover:text-[#ff0000]"><Icon name="youtube" /></a>
        <a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub" class="text-muted hover:text-default"><Icon name="github" /></a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-muted hover:text-[#0a66c2]"><Icon name="linkedin" /></a>
        <a href={mailto} aria-label="Email Alex" title="Email me" class="text-muted hover:text-accent"><Icon name="mail" /></a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
