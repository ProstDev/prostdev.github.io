---
import { thumbnail, type ExternalPlaylist } from '@/data/videos';
import Icon from './Icon.astro';

interface Props {
  playlist: ExternalPlaylist;
}
const { playlist } = Astro.props;
const { title, playlistUrl, coverVideoId, note } = playlist;
const cover = thumbnail(coverVideoId, 'max');
const coverFallback = thumbnail(coverVideoId, 'hq');
---
<article class="group">
  <a
    href={playlistUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Open the ${title} playlist on YouTube (opens in a new tab)`}
    class="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]"
  >
    <div class="relative aspect-video w-full overflow-hidden rounded-xl border border-default bg-black">
      <img
        src={cover}
        data-fallback={coverFallback}
        alt={`Cover: ${title} playlist`}
        loading="lazy"
        decoding="async"
        width="1280"
        height="720"
        onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback}"
        onload="if(this.naturalWidth<=120&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <!-- Honest affordance: opens an external YouTube PLAYLIST in a new tab (not inline play). -->
      <span class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-full bg-[var(--accent-strong)] px-2.5 py-1 text-xs font-semibold text-[var(--accent-contrast)] shadow-sm">
        Playlist
        <Icon name="external" class="h-3.5 w-3.5" />
      </span>
    </div>
    <h3 class="mt-3 font-semibold leading-snug text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
      {title}
    </h3>
    {note && <p class="mt-0.5 text-sm text-muted">{note}</p>}
  </a>
</article>
