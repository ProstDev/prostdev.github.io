---
import { categoryUrl } from '@/lib/content';

interface Props {
  category: string;
  /** Forwarded to the <a> (e.g. data-pagefind-meta="category" on the post page). */
  'data-pagefind-meta'?: string;
}
const { category, ...rest } = Astro.props;
---
<!--
  Solid accent fill behind --accent-contrast text. Uses --accent-strong (NOT --accent):
  brand-500 under white is only 3.46:1 and fails WCAG AA; --accent-strong (brand-600 in light,
  the light accent in dark) clears it in both themes. Arbitrary [var(--…)] utilities are used
  because the bg-accent/text-accent helper classes don't register as Tailwind colors.
-->
<a
  href={categoryUrl(category)}
  class="inline-block rounded-full bg-[var(--accent-strong)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent-contrast)] transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]"
  {...rest}
>
  {category}
</a>
