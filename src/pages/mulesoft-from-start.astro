---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaylistGrid from '@/components/PlaylistGrid.astro';
import { getPlaylist, videosInPlaylist } from '@/data/videos';

const playlist = getPlaylist('mulesoft-from-start')!;
const videos = videosInPlaylist('mulesoft-from-start');
---
<BaseLayout title="MuleSoft from Start: A Beginner's Guide" description={playlist.description}>
  <PlaylistGrid
    playlist={playlist}
    videos={videos}
    hook="New to MuleSoft? This beginner-friendly series is the perfect place to start."
  />
</BaseLayout>
