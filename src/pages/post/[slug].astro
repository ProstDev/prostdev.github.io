---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import DocActions from '@/components/DocActions.astro';
import CodeBlockEnhancer from '@/components/CodeBlockEnhancer.astro';
import ReportIssue from '@/components/ReportIssue.astro';
import LiteYouTube from '@/components/LiteYouTube.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TagChip from '@/components/TagChip.astro';
import Icon from '@/components/Icon.astro';
import SeriesNav from '@/components/SeriesNav.astro';
import ReaderNotes from '@/components/ReaderNotes.astro';
import Faqs from '@/components/Faqs.astro';
import { Image } from 'astro:assets';
import { getPosts, formatDate, readingTime, categoryUrl, getSeriesParts } from '@/lib/content';
import { getSeriesForPost } from '@/data/series';
import { getVideoByYoutubeId } from '@/data/videos';
import { getTranscript } from '@/lib/transcripts';
import { SITE } from '@/config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, author, pubDate, updatedDate, category, tags, heroImage, youtubeId, readerNotes, faqs } = post.data;

const url = new URL(`/post/${post.id}`, SITE.url).href;
const mdUrl = `/post/${post.id}.md`;

// Multi-part series navigation (prev/next + jump menu), driven by src/data/series.ts.
const series = getSeriesForPost(post.id);
const seriesParts = series ? await getSeriesParts(series, post.id) : null;

// If the embedded video has its own catalog page WITH a transcript, surface a
// link under the player so readers can jump there to read/copy the transcript.
// The video still plays inline here; this is just an extra affordance.
const catalogVideo = youtubeId ? getVideoByYoutubeId(youtubeId) : undefined;
const videoTranscriptHref =
  catalogVideo && (await getTranscript(catalogVideo.youtubeId))
    ? `/video/${catalogVideo.slug}#transcript`
    : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Person', name: author },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: url,
    articleSection: category,
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
  // FAQPage JSON-LD — an answer-engine signal for non-Google crawlers (ChatGPT/Perplexity/Copilot);
  // emitted only when the post carries `faqs`. (Google deprecated the FAQ rich result in May 2026,
  // and Gemini/AI Overviews ground on the visible <Faqs> text, not this schema.) Answers are grounded
  // in the post body (see the add-faqs skill); the on-page <Faqs> + the .md `## FAQs` block mirror this.
  ...(faqs && faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.question,
            acceptedAnswer: { '@type': 'Answer', text: f.answer },
          })),
        },
      ]
    : []),
];
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  contained={false}
  jsonLd={jsonLd}
>
  <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article data-pagefind-body>
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-accent">Home</a> ›
        <a href="/blog" class="hover:text-accent">Blog</a> ›
        <a href={categoryUrl(category)} class="hover:text-accent">{category}</a>
      </nav>

      <!-- Header -->
      <header class="mb-6">
        <div class="mb-3 flex flex-wrap items-center gap-3">
          <CategoryBadge category={category} data-pagefind-meta="category" />
          <span class="text-sm text-muted">{formatDate(pubDate)} · {readingTime(post.body)}</span>
        </div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-muted">{description}</p>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-y border-default py-3">
          <span class="text-sm text-muted">By {author}</span>
          <DocActions markdownUrl={mdUrl} />
        </div>
      </header>

      {seriesParts && series && (
        <SeriesNav parts={seriesParts} seriesTitle={series.title} variant="top" />
      )}

      {youtubeId && (
        <div class="mb-8">
          <LiteYouTube youtubeId={youtubeId} title={title} />
          {videoTranscriptHref && (
            <a
              href={videoTranscriptHref}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
            >
              <Icon name="file-text" class="h-4 w-4" />
              Read &amp; copy the full video transcript
              <Icon name="external" class="h-4 w-4" aria-hidden="true" />
            </a>
          )}
        </div>
      )}

      {heroImage && !youtubeId && (
        <Image src={heroImage} alt={title} width={1280} height={720} class="mb-8 w-full rounded-xl border border-default" />
      )}

      <!-- Body -->
      <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:scroll-mt-24">
        <Content />
      </div>
      <CodeBlockEnhancer />

      {readerNotes && readerNotes.length > 0 && (
        <ReaderNotes notes={readerNotes} />
      )}

      {faqs && faqs.length > 0 && (
        <Faqs faqs={faqs} />
      )}

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-default pt-6">
          {tags.map((t) => (
            <TagChip tag={t} data-pagefind-filter="tag" />
          ))}
        </div>
      )}

      {seriesParts && series && (
        <SeriesNav parts={seriesParts} seriesTitle={series.title} variant="bottom" />
      )}
    </article>

    <!-- Right rail TOC -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-6">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <ReportIssue pageUrl={url} pageTitle={title} />
</BaseLayout>
