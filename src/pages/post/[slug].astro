---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import DocActions from '@/components/DocActions.astro';
import CodeBlockEnhancer from '@/components/CodeBlockEnhancer.astro';
import ReportIssue from '@/components/ReportIssue.astro';
import LiteYouTube from '@/components/LiteYouTube.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TagChip from '@/components/TagChip.astro';
import Icon from '@/components/Icon.astro';
import SeriesNav from '@/components/SeriesNav.astro';
import ReaderNotes from '@/components/ReaderNotes.astro';
import Faqs from '@/components/Faqs.astro';
import ScheduledNotice from '@/components/ScheduledNotice.astro';
import { Image } from 'astro:assets';
import { getRenderablePosts, isPostScheduled, formatDate, readingTime, categoryUrl, getSeriesParts } from '@/lib/content';
import { getSeriesForPost } from '@/data/series';
import { getVideoByYoutubeId } from '@/data/videos';
import { getTranscript } from '@/lib/transcripts';
import { buildBreadcrumbList, byline } from '@/lib/jsonld';
import { SITE } from '@/config';

export async function getStaticPaths() {
  // getRenderablePosts() = published + scheduled (future-dated, non-draft). A scheduled post builds
  // a `noindex` teaser here so a link shared before publish returns 200 with the right OG card;
  // listings/feeds/sitemap/.md still use getPosts(), so teasers stay out of them. See src/lib/content.ts.
  const now = new Date();
  const posts = await getRenderablePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    // Teaser fires ONLY in prod — in `npm run dev` scheduled posts render in full for local preview.
    props: { post, scheduled: import.meta.env.PROD && isPostScheduled(post, now) },
  }));
}

const { post, scheduled } = Astro.props;
const { title, description, author, pubDate, updatedDate, category, tags, heroImage, youtubeId, readerNotes, faqs } = post.data;

const url = new URL(`/post/${post.id}`, SITE.url).href;
const mdUrl = `/post/${post.id}.md`;

// Social-share image: a build-time-generated branded card (title over the hero image) served as a
// static PNG from /og/post/<slug>.png. Seo.astro absolutizes this root-relative path. It's built
// for scheduled posts too (identical to the published card), which is the whole point of the teaser.
// See src/pages/og/post/[slug].png.ts + src/lib/og-image.ts.
const ogImage = `/og/post/${post.id}.png`;

// A teaser withholds the article body + all body-dependent work (rendered MDX, series/transcript
// lookups, JSON-LD) — only the header + OG card ship until the post reveals at pubDate. `Content` is
// `any` (a nullable value can't be used as a JSX component) — same idiom as video/[slug].astro.
let Content: any = null;
let headings: Awaited<ReturnType<typeof render>>['headings'] = [];
let seriesParts: Awaited<ReturnType<typeof getSeriesParts>> | null = null;
let series: ReturnType<typeof getSeriesForPost> = undefined;
let videoTranscriptHref: string | null = null;
let jsonLd: Record<string, unknown>[] = [];

if (!scheduled) {
  const rendered = await render(post);
  Content = rendered.Content;
  headings = rendered.headings;

  // Multi-part series navigation (prev/next + jump menu), driven by src/data/series.ts.
  series = getSeriesForPost(post.id);
  seriesParts = series ? await getSeriesParts(series, post.id) : null;

  // If the embedded video has its own catalog page WITH a transcript, surface a
  // link under the player so readers can jump there to read/copy the transcript.
  // The video still plays inline here; this is just an extra affordance.
  const catalogVideo = youtubeId ? getVideoByYoutubeId(youtubeId) : undefined;
  videoTranscriptHref =
    catalogVideo && (await getTranscript(catalogVideo.youtubeId))
      ? `/video/${catalogVideo.slug}#transcript`
      : null;

  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      ...byline(author),
      mainEntityOfPage: url,
      articleSection: category,
      keywords: tags.join(', '),
    },
    buildBreadcrumbList([
      { name: 'Blog', url: `${SITE.url}/blog` },
      { name: title, url },
    ]),
    // FAQPage JSON-LD — an answer-engine signal for non-Google crawlers (ChatGPT/Perplexity/Copilot);
    // emitted only when the post carries `faqs`. (Google deprecated the FAQ rich result in May 2026,
    // and Gemini/AI Overviews ground on the visible <Faqs> text, not this schema.) Answers are grounded
    // in the post body (see the add-faqs skill); the on-page <Faqs> + the .md `## FAQs` block mirror this.
    ...(faqs && faqs.length > 0
      ? [
          {
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.question,
              acceptedAnswer: { '@type': 'Answer', text: f.answer },
            })),
          },
        ]
      : []),
  ];
}
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  contained={false}
  jsonLd={jsonLd}
  noindex={scheduled}
>
  <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <!-- min-w-0: on mobile this is an implicit single `auto` grid track, so the article keeps the
         default grid-item min-width:auto and won't shrink below its widest descendant (a wide table,
         a long inline-code chip) — pushing the whole page sideways on mobile WebKit even though the
         table/code scroll containers are individually contained. min-w-0 lets the track shrink so
         those scroll containers do their job. (lg: already gets this via minmax(0,1fr).) -->
    <!-- data-pagefind-body is OMITTED on a teaser: Pagefind indexes ONLY pages carrying this marker
         (other pages have it), so dropping it keeps the scheduled post out of site search. The
         `noindex` meta alone does NOT do this — Pagefind ignores robots meta, it keys off this attr. -->
    <article data-pagefind-body={scheduled ? undefined : true} class="min-w-0">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-accent">Home</a> ›
        <a href="/blog" class="hover:text-accent">Blog</a> ›
        <a href={categoryUrl(category)} class="hover:text-accent">{category}</a>
      </nav>

      <!-- Header -->
      <header class="mb-6">
        <div class="mb-3 flex flex-wrap items-center gap-3">
          <CategoryBadge category={category} data-pagefind-meta="category" />
          <span class="text-sm text-muted">{formatDate(pubDate)}{!scheduled && <> · {readingTime(post.body)}</>}</span>
        </div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-muted">{description}</p>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-y border-default py-3">
          <span class="text-sm text-muted">By {author}</span>
          {!scheduled && <DocActions markdownUrl={mdUrl} />}
        </div>
      </header>

      {scheduled ? (
        <!-- Teaser: the article is scheduled — show a "coming soon" panel instead of the (embargoed)
             body. The page still returns 200 with the correct OG card so a pre-publish share previews
             right; at pubDate the cron rebuild swaps this for the full body below. -->
        <ScheduledNotice pubDate={pubDate} />
      ) : (
        <>
          {seriesParts && series && (
            <SeriesNav parts={seriesParts} seriesTitle={series.title} variant="top" />
          )}

          {youtubeId && (
            <div class="mb-8">
              <LiteYouTube youtubeId={youtubeId} title={title} />
              {videoTranscriptHref && (
                <a
                  href={videoTranscriptHref}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
                >
                  <Icon name="file-text" class="h-4 w-4" />
                  Read &amp; copy the full video transcript
                  <Icon name="external" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </div>
          )}

          {heroImage && !youtubeId && (
            <Image src={heroImage} alt={title} width={1280} height={720} class="mb-8 w-full rounded-xl border border-default" />
          )}

          <!-- Body -->
          <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:scroll-mt-24">
            <Content />
          </div>
          <CodeBlockEnhancer />

          {readerNotes && readerNotes.length > 0 && (
            <ReaderNotes notes={readerNotes} />
          )}

          {faqs && faqs.length > 0 && (
            <Faqs faqs={faqs} />
          )}

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-2 border-t border-default pt-6">
              {tags.map((t) => (
                <TagChip tag={t} data-pagefind-filter="tag" />
              ))}
            </div>
          )}

          {seriesParts && series && (
            <SeriesNav parts={seriesParts} seriesTitle={series.title} variant="bottom" />
          )}
        </>
      )}
    </article>

    <!-- Right rail TOC (omitted on a teaser — there are no body headings yet) -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-6">
        {!scheduled && <TableOfContents headings={headings} />}
      </div>
    </aside>
  </div>

  {!scheduled && <ReportIssue pageUrl={url} pageTitle={title} />}
</BaseLayout>
