---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaylistGrid from '@/components/PlaylistGrid.astro';
import { getPlaylist, videosInPlaylist } from '@/data/videos';

const showdown = getPlaylist('ai-showdown')!;
const showdownVideos = videosInPlaylist('ai-showdown');

const adventures = getPlaylist('mulesoft-ai-2025')!;
const adventuresVideos = videosInPlaylist('mulesoft-ai-2025');
---
<BaseLayout title={showdown.title} description={showdown.description}>
  <PlaylistGrid
    playlist={showdown}
    videos={showdownVideos}
    hook="New episodes as I test more AI coding tools against real MuleSoft work. 🚀"
  />
  <div class="border-t border-default">
    <PlaylistGrid
      as="h2"
      playlist={adventures}
      videos={adventuresVideos}
      hook="Looking for the 2025 series? Here's the full Adventures in MuleSoft + AI playlist."
    />
  </div>
</BaseLayout>
