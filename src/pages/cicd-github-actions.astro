---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaylistGrid from '@/components/PlaylistGrid.astro';
import { getPlaylist, videosInPlaylist } from '@/data/videos';

const playlist = getPlaylist('cicd-github-actions')!;
const videos = videosInPlaylist('cicd-github-actions');
---
<BaseLayout title="MuleSoft CI/CD with GitHub Actions" description={playlist.description}>
  <PlaylistGrid
    playlist={playlist}
    videos={videos}
    hook="Automate your MuleSoft deployments from a single git push."
  />
</BaseLayout>
