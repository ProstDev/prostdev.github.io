---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCategories, getPostsByCategory, categoryUrl } from '@/lib/content';
import { buildBreadcrumbList, buildItemListPage } from '@/lib/jsonld';
import { SITE } from '@/config';

export async function getStaticPaths() {
  const cats = await getCategories();
  return cats.map(({ category, count }) => ({
    params: { category: category.toLowerCase() },
    props: { category, count },
  }));
}

const { category, count } = Astro.props;
const posts = await getPostsByCategory(category);

// Hand-written one-liner per content-type category (these describe the KIND of post, not a topic —
// topics live in tags + the video section pages).
const BLURBS: Record<string, string> = {
  Tutorials: 'Step-by-step, follow-along builds — open your IDE and ship something by the end.',
  Guides: 'Reference-style deep dives and explainers you can come back to.',
  Opinion: 'Takes, lessons learned, and the occasional rant from building with MuleSoft and AI.',
  News: 'Announcements, releases, and what’s new in the MuleSoft and AI ecosystem.',
  Challenges: 'Problems, puzzles, and real-world scenarios worked through end to end.',
};

const title = category;
const noun = count === 1 ? 'post' : 'posts';
const blurb = BLURBS[category] ?? '';
const description = `${count} ${category} ${noun} on ProstDev. ${blurb}`;
const url = new URL(categoryUrl(category), SITE.url).href;

const jsonLd = [
  buildItemListPage({
    name: `${category} — ProstDev Blog`,
    description,
    url,
    items: posts.map((p) => ({
      url: new URL(`/post/${p.id}`, SITE.url).href,
      name: p.data.title,
    })),
  }),
  buildBreadcrumbList([
    { name: 'Blog', url: `${SITE.url}/blog` },
    { name: category, url },
  ]),
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="py-10">
    <!-- Breadcrumb -->
    <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> ›
      <a href="/blog" class="hover:text-accent">Blog</a> ›
      <span class="text-default">{category}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-accent sm:text-4xl">{category}</h1>
      <p class="mt-3 max-w-2xl text-muted">{blurb}</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <p class="mt-10 text-sm text-muted">
      See every category and topic on the <a href="/blog" class="text-accent hover:underline">blog</a>
      or browse the <a href="/tags" class="text-accent hover:underline">tag directory</a>.
    </p>
  </div>
</BaseLayout>
